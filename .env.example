# --- Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Where the Next.js frontend runs — used to build the Paystack checkout
# callback_url (customers land back on the web app, not this API, after
# paying). Set this to your real domain in production.
WEB_APP_URL=http://localhost:3001

# --- Database ---
DATABASE_URL=postgresql://payder:payder@localhost:5432/payder?schema=public

# --- Redis (sessions, rate limiting, BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_REFRESH_TTL=30d

# --- PII encryption (KYC: NIN/BVN at rest — see common/crypto) ---
# 64 hex chars = 32 bytes (AES-256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret

# --- Flutterwave ---
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxx
FLUTTERWAVE_WEBHOOK_HASH=replace-with-flutterwave-webhook-hash

# --- VTU aggregator (VTpass sandbox) ---
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=replace-me
VTPASS_SECRET_KEY=replace-me
VTPASS_PUBLIC_KEY=replace-me

# --- Remita (Biller API — RRR lookup + Process Transaction) ---
# api-demo.systemspecsng.com is Remita's test/demo base URL; swap for the
# live one Remita gives you at go-live. Auth is a plain `secretKey` header
# (see RemitaProvider), not Bearer/HMAC.
REMITA_BASE_URL=https://api-demo.systemspecsng.com
REMITA_SECRET_KEY=replace-with-your-remita-secret-key
# PAYDER's own fee on top of Remita's (flat + percentage of the invoice
# principal, i.e. rrrAmount — not the Remita-inclusive amount).
REMITA_PORTAL_FLAT_FEE=400
REMITA_PORTAL_PERCENT_FEE=0.6

# --- Pairgate (betting-account funding — see betting module) ---
# https://pairgate.com/developers/introduction — Bearer-token auth. Sandbox:
# set PAIRGATE_USE_SANDBOX=true to hit Pairgate's /test/* purchase endpoints
# (simulated, no real money moves) before a funded live Pairgate wallet exists.
PAIRGATE_BASE_URL=https://pairgate.com/api/v1
PAIRGATE_API_KEY=replace-me
PAIRGATE_USE_SANDBOX=true

# --- Withdrawals (admin-reviewed payout to the customer's own bank) ---
# Flat processing fee: WITHDRAWAL_FEE_LOW applies below the threshold,
# WITHDRAWAL_FEE_HIGH at/above it. Bank list for the withdrawal form is
# fetched live from Paystack's GET /bank using PAYSTACK_SECRET_KEY above,
# with a static fallback list if that call fails.
WITHDRAWAL_FEE_LOW=100
WITHDRAWAL_FEE_HIGH=150
WITHDRAWAL_FEE_THRESHOLD=10000

# --- SMS / Email / Push ---
TERMII_API_KEY=replace-me
SENDGRID_API_KEY=replace-me
FCM_SERVER_KEY=replace-me

# NOTE: this file lists which secrets exist. Real values belong in a secrets
# manager (see architecture doc §8), never committed to git as a real .env.
